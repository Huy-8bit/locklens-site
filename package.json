{
  "name": "locklens-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official LockLens website: landing page, interactive architecture explorer, and documentation.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "test:links": "node scripts/check-links.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm run build && npm run test:links",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.12",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "beautiful-mermaid": "^1.1.3",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "github-slugger": "^2.0.0",
    "globals": "^17.14.0",
    "hast-util-to-string": "^3.0.1",
    "pagefind": "^1.6.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
