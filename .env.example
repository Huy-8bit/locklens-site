# Public URL of the deployed site (used for canonical URLs, Open Graph, sitemap).
SITE_URL=https://your-domain.example
# Optional sub-path when hosting under a prefix (for example GitHub Pages project sites): /locklens
BASE_PATH=
# Path to the LockLens repository checkout whose Markdown is published under /docs.
# Defaults: the parent directory when this site lives in <repo>/site, otherwise ../locklens.
LOCKLENS_REPO=../locklens
# Git ref used for "Edit on GitHub" and source links.
LOCKLENS_REPO_REF=main
