---
import '../styles/landing.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import Showcase from '../components/landing/Showcase.astro';
import Shot from '../components/Shot.astro';
import Code from '../components/Code.astro';
import SignalComparison from '../islands/SignalComparison';
import InvestigationJourney from '../islands/InvestigationJourney';
import BaselineChart from '../islands/BaselineChart';
import { SITE, url } from '../lib/site';
const command = `git clone https://github.com/Huy-8bit/locklens.git\ncd locklens\nmake lab-up`;
---
<BaseLayout title="LockLens" current="home" jsonLd={{'@context':'https://schema.org','@type':'SoftwareApplication',name:SITE.name,applicationCategory:'DeveloperApplication',operatingSystem:'Linux (Docker)',description:SITE.description,codeRepository:SITE.repo,license:'https://opensource.org/licenses/MIT',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}}}>
  <main id="main" class="premium-home">
    <Hero />
    <section class="premium-section comparison-section" aria-labelledby="problem-title">
      <div class="premium-container">
        <div class="section-index" data-reveal><span>01 / CONNECT THE DOTS</span><span>FEWER TABS. FASTER ANSWERS.</span></div>
        <div class="split-heading"><h2 id="problem-title" data-reveal>Four tabs. Three tools.<br/><em>One culprit.</em></h2><p data-reveal>A lock wait in one dashboard, a query in another, a PID in a terminal. LockLens joins them into one story: who is waiting, who is blocking, and what they were running.</p></div>
        <SignalComparison client:visible={{ rootMargin: "400px" }} />
      </div>
    </section>
    <section id="incident-demo" class="premium-section surface-dark investigation-section" aria-labelledby="experience-title">
      <div class="premium-container">
        <div class="section-index" data-reveal><span>02 / WATCH AN INCIDENT UNFOLD</span><span>INTERACTIVE · SIMULATED</span></div>
        <div class="split-heading"><h2 id="experience-title" data-reveal>Thirty seconds of waiting.<br/><em>One root blocker.</em></h2><div data-reveal><p>One long transaction stalls checkout, trips a rule and becomes a recorded incident. Scroll through it — the same sessions stay in view from the first wait to recovery.</p><a class="premium-link" href={url('/architecture/#incident')}>Launch interactive demo <span>↗</span></a></div></div>
        <InvestigationJourney client:visible={{ rootMargin: "400px" }} />
        <p class="visual-caption">A deterministic simulation of LockLens’ documented rules. Illustrative values; no connection to your databases.</p>
      </div>
    </section>
    <section id="features" class="premium-section feature-stories" aria-labelledby="features-title">
      <div class="premium-container">
        <div class="section-index" data-reveal><span>03 / WHAT YOU GET</span><span>DETECT → TRACE → PROVE</span></div>
        <h2 id="features-title" class="features-intro" data-reveal>Built for the 3 a.m. page.<br/><em>Useful at 3 p.m. too.</em></h2>
        <article class="feature-story" aria-labelledby="monitor-title">
          <div class="feature-copy" data-reveal><p class="micro-label">01 — FLEET & INSTANCE VIEW</p><h3 id="monitor-title">Every instance.<br/>One screen.</h3><p>Start at fleet health, then drop into a single server: active sessions, load by wait class, replication lag, and the statements eating your execution time.</p><ul><li>Database load by wait class</li><li>Primary and standby visibility</li><li>Queries compared across time windows</li></ul><a class="premium-link" href={url('/docs/getting-started/ui-guide/')}>Tour the workspace ↗</a></div>
          <div class="feature-visual monitor-visual" data-reveal><span class="visual-eyebrow">ACTUAL PRODUCT / LOCAL LAB</span><Shot name="overview.png" alt="Actual LockLens fleet overview showing PostgreSQL instance health, workload, and incidents" widths={[640,960,1440]}/><div class="visual-foot"><span>One environment. Every instance.</span><a href={url('/docs/features/replication/')}>Replication monitoring ↗</a></div></div>
        </article>
        <article class="feature-story reversed" aria-labelledby="query-title">
          <div class="feature-copy" data-reveal><p class="micro-label">02 — QUERY REGRESSIONS</p><h3 id="query-title">“Slow” compared to what?<br/>Its own history.</h3><p>Every statement is measured against its own baseline for the same hour of day. LockLens tells slower calls apart from simply more calls — and shows the confidence behind each finding.</p><a class="premium-link" href={url('/docs/features/query-performance/')}>How regressions are found ↗</a></div>
          <div class="feature-visual baseline-visual" data-reveal data-ambient><span class="visual-eyebrow">ILLUSTRATIVE / STATEMENT BASELINE</span><BaselineChart client:visible={{ rootMargin: "400px" }} /><div class="baseline-explanation"><span>01 / Establish a baseline</span><span>02 / Compare the window</span><span>03 / Examine the evidence</span></div></div>
        </article>
        <article class="feature-story" aria-labelledby="evidence-title">
          <div class="feature-copy" data-reveal><p class="micro-label">03 — BLOCKING & INCIDENT EVIDENCE</p><h3 id="evidence-title">The lock is gone.<br/>The proof isn’t.</h3><p>LockLens follows PostgreSQL’s own blocker relationships to the root session, then keeps the snapshots, affected sessions and timeline — long after the live activity has vanished.</p><a class="premium-link" href={url('/docs/features/incidents/')}>Inside an incident record ↗</a></div>
          <div class="evidence-document feature-visual" data-reveal data-ambient><div class="evidence-document-header"><span>INCIDENT / 0042</span><span>● RESOLVED</span></div><h4>Blocking chain persisted</h4><p>Illustrative incident record</p><div class="document-timeline">{[['14:01:20','Before the trigger','Activity samples retained'],['14:02:40','Rule triggered','Root blocker + three waiters captured'],['14:03:19','Investigation','Sessions and timeline available'],['14:04:04','Recovery','Three clear samples; evidence preserved']].map(([time,title,desc],i)=><div style={`--event-order:${i}`}><time>{time}</time><span></span><div><strong>{title}</strong><small>{desc}</small></div></div>)}</div><a href={url('/docs/features/blocking-analysis/')}>Explore the blocking graph <span>↗</span></a></div>
        </article>
      </div>
    </section>
    <div class="real-product-section"><Showcase /></div>
    <section class="premium-section surface-dark architecture-teaser" aria-labelledby="arch-title">
      <div class="premium-container">
        <div class="section-index" data-reveal><span>04 / HOW IT FITS</span><span>OUT OF BAND. SELF-HOSTED. YOURS.</span></div>
        <div class="architecture-teaser-grid"><div data-reveal><h2 id="arch-title">Beside your database.<br/><em>Never in front of it.</em></h2><p>LockLens connects to PostgreSQL with its own monitoring role. Your application traffic keeps its existing path, and the history lives in a separate store you run.</p><a class="btn btn-primary" href={url('/architecture/')}>Explore architecture <span>↗</span></a></div><div class="architecture-mini" data-reveal data-ambient><div class="mini-path"><span>Applications</span><i>→</i><span>PostgreSQL</span></div><div class="mini-observation"><span>Observation</span><i></i></div><div class="mini-locklens"><span>◈</span><strong>LockLens</strong><small>Collection · rules · API</small></div><div class="mini-store"><i>↓</i><span>Separate monitoring store</span></div></div></div>
        <div class="platform-facts"><div><strong>14–18</strong><span>PostgreSQL versions</span></div><div><strong>Self-hosted</strong><span>Inside your infrastructure</span></div><div><strong>MIT</strong><span>Open source, inspectable</span></div></div>
      </div>
    </section>
    <section id="quick-start" class="premium-section start-section" aria-labelledby="start-title"><div class="premium-container start-grid"><div data-reveal><p class="micro-label">TRY IT ON YOUR LAPTOP</p><h2 id="start-title">Break a database.<br/><em>Watch LockLens catch it.</em></h2><p>One command starts a local lab with Docker Compose.<br/>Trigger a blocking chain, then follow the evidence.</p><a class="btn btn-primary" href={url('/docs/getting-started/')}>Get started <span>↗</span></a></div><div class="surface-dark start-terminal" data-reveal><Code code={command} lang="sh" title="Start your local lab"/><p class="visual-caption">Requires Docker Compose v2. First build takes a few minutes.</p><p class="project-note">LockLens is early-stage software, tested in a local lab. Production behavior and performance are not yet validated. <a href={url('/docs/deployment/limitations/')}>Read the limitations ↗</a></p></div></div></section>
  </main>
</BaseLayout>
