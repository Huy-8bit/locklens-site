---
import '../styles/landing.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import Showcase from '../components/landing/Showcase.astro';
import Shot from '../components/Shot.astro';
import Code from '../components/Code.astro';
import SignalComparison from '../islands/SignalComparison';
import InvestigationJourney from '../islands/InvestigationJourney';
import BaselineChart from '../islands/BaselineChart';
import { SITE, url } from '../lib/site';
const command = `git clone https://github.com/Huy-8bit/locklens.git\ncd locklens\nmake lab-up`;
---
<BaseLayout title="LockLens" current="home" jsonLd={{'@context':'https://schema.org','@type':'SoftwareApplication',name:SITE.name,applicationCategory:'DeveloperApplication',operatingSystem:'Linux (Docker)',description:SITE.description,codeRepository:SITE.repo,license:'https://opensource.org/licenses/MIT',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}}}>
  <main id="main" class="premium-home">
    <Hero />
    <section class="premium-section comparison-section" aria-labelledby="problem-title">
      <div class="premium-container">
        <div class="section-index" data-reveal><span>01 / CONNECT THE CONTEXT</span><span>LESS ASSEMBLY. MORE UNDERSTANDING.</span></div>
        <div class="split-heading"><h2 id="problem-title" data-reveal>The clues are there.<br/><em>Make the connection.</em></h2><p data-reveal>A wait event here. A query over there. Bring observations together to see which session is holding up the work — and keep the context when it ends.</p></div>
        <SignalComparison client:visible={{ rootMargin: "400px" }} />
      </div>
    </section>
    <section id="incident-demo" class="premium-section surface-dark investigation-section" aria-labelledby="experience-title">
      <div class="premium-container">
        <div class="section-index" data-reveal><span>02 / FOLLOW THE INVESTIGATION</span><span>INTERACTIVE PRODUCT STORY</span></div>
        <div class="split-heading"><h2 id="experience-title" data-reveal>From the first wait<br/>to the <em>full picture.</em></h2><div data-reveal><p>Follow one transaction through a growing blocking chain, a triggered rule, and a recorded incident. The same sessions stay in view as the story unfolds.</p><a class="premium-link" href={url('/architecture/#incident')}>Launch interactive demo <span>↗</span></a></div></div>
        <InvestigationJourney client:visible={{ rootMargin: "400px" }} />
        <p class="visual-caption">A deterministic simulation of LockLens’ documented rules. Illustrative values; no connection to your databases.</p>
      </div>
    </section>
    <section id="features" class="premium-section feature-stories" aria-labelledby="features-title">
      <div class="premium-container">
        <div class="section-index" data-reveal><span>03 / BUILT FOR THE INVESTIGATION</span><span>OBSERVE → UNDERSTAND → ACT WITH CONTEXT</span></div>
        <h2 id="features-title" class="features-intro" data-reveal>Every signal.<br/><em>A sharper perspective.</em></h2>
        <article class="feature-story" aria-labelledby="monitor-title">
          <div class="feature-copy" data-reveal><p class="micro-label">01 — REAL-TIME MONITORING</p><h3 id="monitor-title">Your fleet.<br/>In focus.</h3><p>Move from fleet health to the activity of one PostgreSQL instance. Explore active sessions, workload, replication lag, and the statements consuming execution time.</p><ul><li>Database load by wait class</li><li>Primary and standby visibility</li><li>Queries compared across time windows</li></ul><a class="premium-link" href={url('/docs/getting-started/ui-guide/')}>Explore the monitoring workspace ↗</a></div>
          <div class="feature-visual monitor-visual" data-reveal><span class="visual-eyebrow">ACTUAL PRODUCT / LOCAL LAB</span><Shot name="overview.png" alt="Actual LockLens fleet overview showing PostgreSQL instance health, workload, and incidents" widths={[640,960,1440]}/><div class="visual-foot"><span>One environment. Every instance.</span><a href={url('/docs/features/replication/')}>Replication monitoring ↗</a></div></div>
        </article>
        <article class="feature-story reversed" aria-labelledby="query-title">
          <div class="feature-copy" data-reveal><p class="micro-label">02 — QUERY PERFORMANCE</p><h3 id="query-title">Slow is relative.<br/>Context is everything.</h3><p>Compare a statement with its own history. Separate slower calls from more calls, with baseline coverage, confidence, and the evidence behind each finding.</p><a class="premium-link" href={url('/docs/features/query-performance/')}>Understand query regressions ↗</a></div>
          <div class="feature-visual baseline-visual" data-reveal data-ambient><span class="visual-eyebrow">ILLUSTRATIVE / STATEMENT BASELINE</span><BaselineChart client:visible={{ rootMargin: "400px" }} /><div class="baseline-explanation"><span>01 / Establish a baseline</span><span>02 / Compare the window</span><span>03 / Examine the evidence</span></div></div>
        </article>
        <article class="feature-story" aria-labelledby="evidence-title">
          <div class="feature-copy" data-reveal><p class="micro-label">03 — BLOCKING & INCIDENT EVIDENCE</p><h3 id="evidence-title">The incident ends.<br/>The evidence stays.</h3><p>Follow PostgreSQL’s blocker relationships to the root session. Keep snapshots, affected sessions, and the incident timeline for investigation after the live activity is gone.</p><a class="premium-link" href={url('/docs/features/incidents/')}>Explore incident investigation ↗</a></div>
          <div class="evidence-document feature-visual" data-reveal data-ambient><div class="evidence-document-header"><span>INCIDENT / 0042</span><span>● RESOLVED</span></div><h4>Blocking chain persisted</h4><p>Illustrative incident record</p><div class="document-timeline">{[['14:01:20','Before the trigger','Activity samples retained'],['14:02:40','Rule triggered','Root blocker + three waiters captured'],['14:03:19','Investigation','Sessions and timeline available'],['14:04:04','Recovery','Three clear samples; evidence preserved']].map(([time,title,desc],i)=><div style={`--event-order:${i}`}><time>{time}</time><span></span><div><strong>{title}</strong><small>{desc}</small></div></div>)}</div><a href={url('/docs/features/blocking-analysis/')}>Explore the blocking graph <span>↗</span></a></div>
        </article>
      </div>
    </section>
    <div class="real-product-section"><Showcase /></div>
    <section class="premium-section surface-dark architecture-teaser" aria-labelledby="arch-title">
      <div class="premium-container">
        <div class="section-index" data-reveal><span>04 / BUILT TO OBSERVE</span><span>READ-ONLY. OUT OF BAND. YOURS.</span></div>
        <div class="architecture-teaser-grid"><div data-reveal><h2 id="arch-title">Fits your system.<br/><em>Stays out of its way.</em></h2><p>LockLens connects directly to PostgreSQL using a read-only monitoring role. Your application traffic follows its existing path. Monitoring history lives in a separate store.</p><a class="btn btn-primary" href={url('/architecture/')}>Explore architecture <span>↗</span></a></div><div class="architecture-mini" data-reveal data-ambient><div class="mini-path"><span>Applications</span><i>→</i><span>PostgreSQL</span></div><div class="mini-observation"><span>Read-only observation</span><i></i></div><div class="mini-locklens"><span>◈</span><strong>LockLens</strong><small>Collection · rules · API</small></div><div class="mini-store"><i>↓</i><span>Separate monitoring store</span></div></div></div>
        <div class="platform-facts"><div><strong>14–18</strong><span>PostgreSQL versions</span></div><div><strong>Self-hosted</strong><span>Inside your infrastructure</span></div><div><strong>MIT</strong><span>Open source, inspectable</span></div></div>
      </div>
    </section>
    <section id="quick-start" class="premium-section start-section" aria-labelledby="start-title"><div class="premium-container start-grid"><div data-reveal><p class="micro-label">YOUR NEXT INVESTIGATION STARTS HERE</p><h2 id="start-title">Bring your database<br/><em>into focus.</em></h2><p>Start a local lab with Docker Compose.<br/>Create a blocking chain. Follow the evidence.</p><a class="btn btn-primary" href={url('/docs/getting-started/')}>Get started <span>↗</span></a></div><div class="surface-dark start-terminal" data-reveal><Code code={command} lang="sh" title="Start your local lab"/><p class="visual-caption">Requires Docker Compose v2. First build takes a few minutes.</p><p class="project-note">LockLens is early-stage software, tested in a local lab. Production behavior and performance are not yet validated. <a href={url('/docs/deployment/limitations/')}>Read the limitations ↗</a></p></div></div></section>
  </main>
</BaseLayout>
