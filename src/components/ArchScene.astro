---
/*
 * Isometric architecture scene for the /architecture hero.
 * Accurate to the product: applications talk to PostgreSQL directly; LockLens sits on its own
 * "out of band" plate, observes PostgreSQL over its own connection, and writes to a separate
 * monitoring store. Purely decorative geometry; the meaning is in the aria-label.
 */
const C = Math.cos(Math.PI / 6); // 0.866
const S = 0.5;
type V3 = [number, number, number];
const P = (x: number, y: number, z = 0): [number, number] => [(x - y) * C, (x + y) * S - z];
const pts = (...ps: V3[]) => ps.map(([x, y, z]) => P(x, y, z).map((n) => n.toFixed(1)).join(',')).join(' ');
const line = (...ps: V3[]) => 'M' + ps.map(([x, y, z]) => P(x, y, z).map((n) => n.toFixed(1)).join(' ')).join(' L');

function box(x: number, y: number, z: number, w: number, d: number, h: number) {
  return {
    top: pts([x, y, z + h], [x + w, y, z + h], [x + w, y + d, z + h], [x, y + d, z + h]),
    left: pts([x, y + d, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x, y + d, z]),
    right: pts([x + w, y, z + h], [x + w, y + d, z + h], [x + w, y + d, z], [x + w, y, z]),
  };
}
function cylinder(cx: number, cy: number, z: number, r: number, h: number, bands: number[] = []) {
  const [X, Yt] = P(cx, cy, z + h);
  const [, Yb] = P(cx, cy, z);
  const a = r * Math.SQRT2 * C;
  const b = r * Math.SQRT2 * S;
  const f = (n: number) => n.toFixed(1);
  return {
    body: `M${f(X - a)} ${f(Yt)} L${f(X - a)} ${f(Yb)} A${f(a)} ${f(b)} 0 0 0 ${f(X + a)} ${f(Yb)} L${f(X + a)} ${f(Yt)} Z`,
    top: { cx: f(X), cy: f(Yt), rx: f(a), ry: f(b) },
    bands: bands.map((t) => {
      const y = Yb - (Yb - Yt) * t;
      return `M${f(X - a)} ${f(y)} A${f(a)} ${f(b)} 0 0 0 ${f(X + a)} ${f(y)}`;
    }),
    x: X,
    yTop: Yt,
  };
}
const grid = (x0: number, y0: number, x1: number, y1: number, step: number) => {
  const out: string[] = [];
  for (let x = x0 + step; x < x1; x += step) out.push(line([x, y0, 0], [x, y1, 0]));
  for (let y = y0 + step; y < y1; y += step) out.push(line([x0, y, 0], [x1, y, 0]));
  return out.join(' ');
};

// World layout (units ≈ px before projection).
const infra = box(0, 0, -12, 230, 230, 12);
const oob = box(270, 30, -12, 160, 220, 12);
// Draw order is back-to-front: farther objects (smaller x + y) first.
const apps = [box(20, 158, 0, 26, 26, 30), box(54, 158, 0, 26, 26, 44), box(88, 158, 0, 26, 26, 22)];
const pg = cylinder(165, 104, 0, 34, 66, [0.33, 0.66]);
const locklens = box(312, 66, 0, 84, 84, 36);
const store = cylinder(354, 210, 0, 22, 34, [0.5]);

const traffic = line([67, 156, 0], [67, 104, 0], [128, 104, 0]);
const observe = line([200, 104, 0], [312, 104, 0]);
const persist = line([354, 150, 0], [354, 182, 0]);

const [llX, llY] = P(354, 108, 36);
const [halo] = [P(354, 108, 0)];
const tag = (x: number, y: number, z: number) => P(x, y, z);
const tApps = tag(67, 171, 84);
const tPg = tag(165, 104, 108);
const tLl = [llX, llY - 44] as const;
const tStore = tag(354, 210, 60);
const floorText = (x: number, y: number) => {
  const [X, Y] = P(x, y, 0);
  return `matrix(${C.toFixed(3)} 0.5 ${(-C).toFixed(3)} 0.5 ${X.toFixed(1)} ${Y.toFixed(1)})`;
};
const w = (s: string, size = 6.6) => s.length * size + 22;
---
<figure class="arch-scene" data-ambient role="img" aria-label="Applications connect directly to PostgreSQL. LockLens runs out of band, observes PostgreSQL through its own connection, and keeps history and incident evidence in a separate monitoring store.">
  <svg viewBox="-215 -40 560 430" class="arch-scene-svg" aria-hidden="true">
    <defs>
      <linearGradient id="as-cyl" x1="0" x2="1">
        <stop offset="0" stop-color="#f4f7fd" />
        <stop offset="0.55" stop-color="#dfe7f4" />
        <stop offset="1" stop-color="#b9c9e3" />
      </linearGradient>
      <linearGradient id="as-cyl-blue" x1="0" x2="1">
        <stop offset="0" stop-color="#eaf1ff" />
        <stop offset="1" stop-color="#9fbcf5" />
      </linearGradient>
      <radialGradient id="as-halo">
        <stop offset="0" stop-color="#59b2ff" stop-opacity="0.55" />
        <stop offset="1" stop-color="#59b2ff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Plates -->
    <g class="as-plate">
      <polygon points={infra.left} class="as-side-l" />
      <polygon points={infra.right} class="as-side-r" />
      <polygon points={infra.top} class="as-plate-top" />
      <path d={grid(0, 0, 230, 230, 23)} class="as-grid" />
    </g>
    <g class="as-plate as-plate-oob">
      <polygon points={oob.left} class="as-side-l" />
      <polygon points={oob.right} class="as-side-r" />
      <polygon points={oob.top} class="as-plate-top as-plate-dashed" />
      <path d={grid(270, 30, 430, 250, 20)} class="as-grid" />
    </g>
    <text transform={floorText(10, 222)} class="as-floor-label">YOUR INFRASTRUCTURE</text>
    <text transform={floorText(280, 242)} class="as-floor-label as-floor-label-blue">OUT OF BAND</text>

    <!-- Paths on the floor -->
    <path d={traffic} class="as-path as-traffic" />
    <path d={traffic} class="as-particles as-traffic-dots" />
    <path d={observe} class="as-path as-observe" />
    <path d={observe} class="as-particles as-observe-dots" />
    <path d={persist} class="as-path as-observe" />
    <text transform={floorText(214, 97)} class="as-path-label as-path-label-blue">OBSERVES</text>

    <!-- Applications -->
    {apps.map((b) => (
      <g class="as-block">
        <polygon points={b.left} class="as-face-l" />
        <polygon points={b.right} class="as-face-r" />
        <polygon points={b.top} class="as-face-t" />
      </g>
    ))}

    <!-- PostgreSQL -->
    <g class="as-cylinder">
      <path d={pg.body} fill="url(#as-cyl)" class="as-cyl-body" />
      {pg.bands.map((d) => <path d={d} class="as-cyl-band" />)}
      <ellipse {...pg.top} class="as-cyl-top" />
      <ellipse cx={pg.top.cx} cy={pg.top.cy} rx={Number(pg.top.rx) * 0.62} ry={Number(pg.top.ry) * 0.62} class="as-cyl-inner" />
    </g>

    <!-- Monitoring store -->
    <g class="as-cylinder as-store">
      <path d={store.body} fill="url(#as-cyl-blue)" class="as-cyl-body" />
      {store.bands.map((d) => <path d={d} class="as-cyl-band" />)}
      <ellipse {...store.top} class="as-cyl-top as-store-top" />
    </g>

    <!-- LockLens -->
    <ellipse cx={halo[0]} cy={halo[1]} rx="120" ry="60" fill="url(#as-halo)" class="as-halo" />
    <g class="as-locklens">
      <polygon points={locklens.left} class="as-ll-l" />
      <polygon points={locklens.right} class="as-ll-r" />
      <polygon points={locklens.top} class="as-ll-t" />
      <g transform={`translate(${llX.toFixed(1)} ${llY.toFixed(1)})`} class="as-ll-mark">
        <ellipse rx="17" ry="9.8" class="as-ll-ring" />
        <circle cx="-2" cy="-1.5" r="5" class="as-ll-lens" />
        <path d="M2 2 L7 5" class="as-ll-lens" />
      </g>
    </g>

    <!-- Tags -->
    <g transform={`translate(${tApps[0].toFixed(1)} ${tApps[1].toFixed(1)})`} class="as-tag">
      <line y1="10" y2="26" class="as-tag-lead" />
      <rect x={-w('Applications') / 2} y="-12" width={w('Applications')} height="24" rx="12" />
      <text y="4">Applications</text>
    </g>
    <g transform={`translate(${tPg[0].toFixed(1)} ${tPg[1].toFixed(1)})`} class="as-tag">
      <line y1="10" y2="34" class="as-tag-lead" />
      <rect x={-w('PostgreSQL') / 2} y="-12" width={w('PostgreSQL')} height="24" rx="12" />
      <text y="4">PostgreSQL</text>
    </g>
    <g transform={`translate(${tLl[0].toFixed(1)} ${tLl[1].toFixed(1)})`} class="as-tag as-tag-blue">
      <g class="as-float">
        <rect x={-w('LockLens', 7.2) / 2} y="-13" width={w('LockLens', 7.2)} height="26" rx="13" />
        <text y="4.5">LockLens</text>
      </g>
    </g>
    <g transform={`translate(${tStore[0].toFixed(1)} ${tStore[1].toFixed(1)})`} class="as-tag as-tag-sm">
      <line x1="-34" y1="10" x2="-14" y2="30" class="as-tag-lead" />
      <rect x={-w('Monitoring store', 6) / 2 - 40} y="-11" width={w('Monitoring store', 6)} height="22" rx="11" />
      <text x="-40" y="3.5">Monitoring store</text>
    </g>
  </svg>
  <figcaption class="arch-scene-legend">
    <span><i class="lg-traffic"></i>Application traffic</span>
    <span><i class="lg-observe"></i>Observation</span>
    <span class="arch-scene-note">Illustrative</span>
  </figcaption>
</figure>

<style>
  .arch-scene {
    position: relative;
    margin: 0;
  }
  .arch-scene-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .as-side-l {
    fill: #d6e1f1;
    stroke: #b4c5e0;
    stroke-width: 0.8;
  }
  .as-side-r {
    fill: #bfcfe7;
    stroke: #a9bcdc;
    stroke-width: 0.8;
  }
  .as-plate-top {
    fill: #f8fbff;
    stroke: #afc3e0;
    stroke-width: 1;
  }
  .as-plate-oob .as-plate-top {
    fill: #f1f6ff;
  }
  .as-plate-dashed {
    stroke: #3d8bff;
    stroke-dasharray: 6 5;
  }
  .as-grid {
    fill: none;
    stroke: #dbe5f3;
    stroke-width: 0.8;
  }
  .as-floor-label {
    font: 600 8px var(--font-mono);
    letter-spacing: 0.22em;
    fill: #56688a;
  }
  .as-floor-label-blue {
    fill: #155ef5;
  }
  .as-path {
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .as-traffic {
    stroke: #9fb0c8;
  }
  .as-observe {
    stroke: #3d8bff;
    stroke-dasharray: 6 6;
    animation: as-dash 1.2s linear infinite;
  }
  .as-particles {
    fill: none;
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-dasharray: 0.1 26;
    animation: as-particles 2.2s linear infinite;
  }
  .as-traffic-dots {
    stroke: #6d7f99;
  }
  .as-observe-dots {
    stroke: #155ef5;
    animation-duration: 2.8s;
  }
  .as-path-label {
    font: 600 7px var(--font-mono);
    letter-spacing: 0.16em;
    fill: #56688a;
  }
  .as-path-label-blue {
    fill: #155ef5;
  }
  .as-face-t {
    fill: #ffffff;
    stroke: #a9bcdc;
    stroke-width: 0.9;
  }
  .as-face-l {
    fill: #e3eaf6;
    stroke: #a9bcdc;
    stroke-width: 0.9;
  }
  .as-face-r {
    fill: #c8d6ec;
    stroke: #a9bcdc;
    stroke-width: 0.9;
  }
  .as-cyl-body {
    stroke: #a9bcdc;
    stroke-width: 0.9;
  }
  .as-cyl-band {
    fill: none;
    stroke: #a9bcdc;
    stroke-width: 0.9;
  }
  .as-cyl-top {
    fill: #fbfdff;
    stroke: #a9bcdc;
    stroke-width: 0.9;
  }
  .as-cyl-inner {
    fill: none;
    stroke: #3d8bff;
    stroke-width: 1.4;
  }
  .as-store-top {
    fill: #eef4ff;
    stroke: #7fa6ef;
  }
  .as-ll-t {
    fill: #4d8dff;
    stroke: #2a6dff;
    stroke-width: 1;
  }
  .as-ll-l {
    fill: #155ef5;
  }
  .as-ll-r {
    fill: #0b3fb0;
  }
  .as-ll-ring {
    fill: none;
    stroke: rgb(255 255 255 / 0.85);
    stroke-width: 1.6;
  }
  .as-ll-lens {
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .as-locklens,
  .as-float {
    animation: as-float 5s ease-in-out infinite;
  }
  .as-halo {
    animation: as-halo 5s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  .as-tag rect {
    fill: #fff;
    stroke: #afc3e0;
    filter: drop-shadow(0 6px 8px rgb(10 22 49 / 0.12));
  }
  .as-tag text {
    font: 600 11px var(--font-sans);
    fill: #0a1631;
    text-anchor: middle;
  }
  .as-tag-sm text {
    font-size: 10px;
  }
  .as-tag-lead {
    stroke: #8ea6cb;
    stroke-dasharray: 2 3;
  }
  .as-tag-blue rect {
    fill: #155ef5;
    stroke: #155ef5;
  }
  .as-tag-blue text {
    fill: #fff;
    font-size: 12px;
  }
  .arch-scene-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 8px;
    font: 500 11px var(--font-sans);
    color: #46587a;
  }
  .arch-scene-legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .arch-scene-legend i {
    width: 22px;
    height: 0;
    border-top: 2.4px solid #9fb0c8;
  }
  .arch-scene-legend .lg-observe {
    border-top: 2.4px dashed #3d8bff;
  }
  .arch-scene-note {
    margin-left: auto;
    font: 600 9px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #56688a;
  }
  @keyframes as-dash {
    to {
      stroke-dashoffset: -24;
    }
  }
  @keyframes as-particles {
    to {
      stroke-dashoffset: -52.2;
    }
  }
  @keyframes as-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
  @keyframes as-halo {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(0.9);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .as-observe,
    .as-particles,
    .as-locklens,
    .as-float,
    .as-halo {
      animation: none;
    }
    .as-particles {
      display: none;
    }
  }
</style>
