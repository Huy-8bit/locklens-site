---
import SectionHeader from '../SectionHeader.astro';
const problems = [
  {
    k: '01',
    title: 'Dashboards show symptoms',
    body: 'Latency is up and connections are climbing. A chart cannot tell you which session holds the lock everyone else is waiting for.',
    fix: 'LockLens builds the blocker → waiter graph from pg_blocking_pids() and names the root blocker.',
  },
  {
    k: '02',
    title: 'Evidence disappears',
    body: 'By the time someone runs a query against pg_stat_activity, the transaction has committed and the chain is gone.',
    fix: 'The incident recorder keeps samples from before the trigger, the graph, the sessions, and a timeline.',
  },
  {
    k: '03',
    title: '“Slow” has no reference',
    body: 'A statement at 8 ms might be normal at noon and a regression at 3 a.m. Global thresholds miss both.',
    fix: 'Every statement is compared with its own baseline by hour of day, with confidence and impact.',
  },
];
---
<section class="relative border-t border-line py-24 sm:py-28" aria-labelledby="problem-title">
  <div class="mx-auto max-w-[1320px] px-4 sm:px-6">
    <SectionHeader id="problem-title" eyebrow="The problem" title="Metrics tell you something is wrong. Not who is blocking whom." lead="PostgreSQL already knows the answers — in pg_stat_activity, pg_locks and pg_stat_statements — for a few seconds at a time. LockLens reads them continuously and keeps what matters." />
    <ol class="mt-14 grid gap-4 md:grid-cols-3">
      {problems.map((p, i) => (
        <li class="problem-card panel relative overflow-hidden p-6" data-reveal style={`transition-delay:${i * 90}ms`}>
          <span class="font-mono text-xs text-fg-subtle">{p.k}</span>
          <h3 class="mt-3 text-lg font-semibold text-fg">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-fg-muted">{p.body}</p>
          <p class="mt-5 flex gap-2.5 border-t border-line pt-4 text-sm leading-relaxed text-accent">
            <span class="mt-1 text-accent" aria-hidden="true">→</span>{p.fix}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
