---
import { getImage } from 'astro:assets';
import HeroScene from '../../islands/HeroScene';
import { screenshot } from '../../lib/images';
import { SITE, url } from '../../lib/site';
const incident = screenshot('incident.png');
const shot = await getImage({ src: incident, width: 960, format: 'webp', quality: 80 });
---
<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-grid mask-radial opacity-80"></div>
    <div class="absolute -top-40 left-1/2 h-[560px] w-[1100px] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(34,211,238,0.16),transparent)]"></div>
    <div class="absolute -right-40 top-40 h-[420px] w-[620px] rounded-full bg-[radial-gradient(closest-side,rgba(139,92,246,0.14),transparent)]"></div>
  </div>
  <div class="relative mx-auto grid max-w-[1320px] items-center gap-12 px-4 pb-20 pt-14 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.08fr)] lg:pb-28 lg:pt-20">
    <div>
      <a href={SITE.repo} rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-line-strong bg-ink-900/70 py-1 pl-1.5 pr-3 text-xs text-fg-muted transition-colors hover:border-accent/40 hover:text-fg">
        <span class="rounded-full bg-accent/15 px-2 py-0.5 font-medium text-accent">Open source</span>
        MIT licensed · PostgreSQL 14–18
        <span aria-hidden="true">→</span>
      </a>
      <h1 id="hero-title" class="mt-6 text-[clamp(2.6rem,6vw,4.6rem)] font-semibold leading-[1.02] tracking-[-0.035em]">
        <span class="text-gradient">See beyond</span><br />PostgreSQL metrics.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-fg-muted">
        Understand slow queries, trace blocking chains, investigate performance regressions, and uncover the evidence behind PostgreSQL incidents.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={url('/#features')} class="btn btn-primary">Explore LockLens</a>
        <a href={url('/architecture/')} class="btn btn-ghost">View architecture</a>
        <a href={url('/docs/getting-started/')} class="btn btn-ghost">Get started →</a>
      </div>
      <dl class="mt-10 grid max-w-xl grid-cols-2 gap-x-6 gap-y-4 text-sm sm:grid-cols-4">
        <div><dt class="text-fg-subtle">Access</dt><dd class="mt-0.5 font-medium text-fg">Read-only role</dd></div>
        <div><dt class="text-fg-subtle">Deploys as</dt><dd class="mt-0.5 font-medium text-fg">Two images</dd></div>
        <div><dt class="text-fg-subtle">History in</dt><dd class="mt-0.5 font-medium text-fg">Its own store</dd></div>
        <div><dt class="text-fg-subtle">Remediation</dt><dd class="mt-0.5 font-medium text-fg">Never automatic</dd></div>
      </dl>
    </div>
    <div class="relative">
      <HeroScene client:idle screenshot={{ src: shot.src, width: 960, height: Math.round((incident.height * 960) / incident.width) }} />
    </div>
  </div>
</section>
