---
import SignalSculpture from './SignalSculpture.astro';
import { SITE, url } from '../../lib/site';
---
<section class="platform-hero concept-hero" aria-labelledby="hero-title" data-ambient>
  <div class="hero-grid premium-container">
    <div class="hero-copy">
      <a href={SITE.repo} class="open-source-label hero-enter"><span></span> OPEN SOURCE · POSTGRESQL OBSERVABILITY <span aria-hidden="true">↗</span></a>
      <h1 id="hero-title" class="hero-enter">Find the cause behind PostgreSQL <em>slowdowns.</em></h1>
      <p class="hero-enter">Detect blocking chains, investigate query regressions, correlate database activity, and preserve incident evidence in one workspace.</p>
      <div class="hero-actions hero-enter"><a href={url('/#features')} class="btn btn-primary">Explore LockLens <span aria-hidden="true">↗</span></a><a href={SITE.repo} class="btn btn-ghost">View on GitHub <span aria-hidden="true">→</span></a></div>
      <div class="hero-facts"><span>Read-only by design</span><span>Self-hosted</span><span>MIT licensed</span></div>
    </div>
    <SignalSculpture />
  </div>
  <div class="hero-bottom premium-container"><span>POSTGRESQL, UNDERSTOOD.</span><div><span>01 <b>Observe</b></span><i></i><span>02 <b>Investigate</b></span><i></i><span>03 <b>Preserve</b></span></div><a href={url('/architecture/')}>View architecture <span aria-hidden="true">↗</span></a></div>
</section>
<div class="platform-stack"><div class="premium-container"><span>AT HOME IN YOUR STACK</span><ul aria-label="Technologies and integrations">{['PostgreSQL', 'Docker', 'Prometheus', 'Grafana', 'OpenTelemetry'].map(t=><li>{t}</li>)}</ul></div></div>
