---
import { url } from '../lib/site';
---
<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title" data-pagefind-base={url('/pagefind/')}>
  <div class="flex items-center gap-3 border-b border-line px-4">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-fg-subtle" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <h2 id="search-title" class="sr-only">Search the documentation</h2>
    <input
      id="search-input"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search titles, headings, and content…"
      class="h-14 w-full bg-transparent text-[0.95rem] text-fg placeholder:text-fg-subtle focus:outline-none [&::-webkit-search-cancel-button]:hidden"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <button type="button" data-search-close class="kbd shrink-0" aria-label="Close search">Esc</button>
  </div>
  <div class="max-h-[min(62vh,560px)] overflow-y-auto overscroll-contain p-2">
    <p id="search-status" class="px-3 py-6 text-center text-sm text-fg-subtle" aria-live="polite">Type to search all documentation.</p>
    <ul id="search-results" role="listbox" aria-label="Search results" class="space-y-1"></ul>
  </div>
  <div class="flex items-center gap-4 border-t border-line px-4 py-2.5 text-[0.72rem] text-fg-subtle">
    <span><kbd class="kbd">↑</kbd> <kbd class="kbd">↓</kbd> to navigate</span>
    <span><kbd class="kbd">Enter</kbd> to open</span>
    <span class="ml-auto hidden sm:inline">Full-text search, built at deploy time</span>
  </div>
</dialog>

<style is:global>
  .search-dialog {
    width: min(680px, calc(100vw - 24px));
    margin: 10vh auto auto;
    padding: 0;
    border-radius: 16px;
    border: 1px solid var(--color-line-strong);
    background: rgb(11 17 32 / 0.97);
    color: var(--color-fg);
    box-shadow: 0 30px 120px -20px rgb(0 0 0 / 0.8), 0 0 0 1px rgb(34 211 238 / 0.08);
  }
  .search-dialog::backdrop {
    background: rgb(2 6 23 / 0.7);
    backdrop-filter: blur(4px);
  }
  .search-result {
    display: block;
    padding: 0.65rem 0.8rem;
    border-radius: 10px;
    border: 1px solid transparent;
  }
  .search-result[aria-selected='true'] {
    background: rgb(34 211 238 / 0.08);
    border-color: rgb(34 211 238 / 0.3);
  }
  .search-result mark {
    background: rgb(34 211 238 / 0.22);
    color: #ecfeff;
    border-radius: 3px;
    padding: 0 1px;
  }
</style>

<script>
  type PagefindResult = { id: string; data: () => Promise<PagefindData> };
  type PagefindSub = { title: string; url: string; excerpt: string };
  type PagefindData = { url: string; excerpt: string; meta: Record<string, string>; sub_results?: PagefindSub[] };
  type Pagefind = { search: (q: string) => Promise<{ results: PagefindResult[] }>; init?: () => Promise<void>; options?: (o: object) => Promise<void> };

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const list = document.getElementById('search-results') as HTMLUListElement | null;
  const status = document.getElementById('search-status') as HTMLParagraphElement | null;

  if (dialog && input && list && status) {
    let pagefind: Pagefind | null = null;
    let loadError = false;
    let selected = -1;
    let lastQuery = '';
    let opener: HTMLElement | null = null;
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
    document.querySelectorAll('[data-search-kbd]').forEach((k) => (k.textContent = isMac ? '⌘K' : 'Ctrl K'));

    const load = async () => {
      if (pagefind || loadError) return pagefind;
      try {
        const base = dialog.dataset.pagefindBase ?? '/pagefind/';
        pagefind = (await import(/* @vite-ignore */ `${base}pagefind.js`)) as Pagefind;
        await pagefind.options?.({ excerptLength: 22, baseUrl: import.meta.env.BASE_URL });
        await pagefind.init?.();
      } catch {
        loadError = true;
        status.textContent = import.meta.env.DEV
          ? 'The search index is generated by `npm run build`. Run a production build and `npm run preview` to search.'
          : 'Search is unavailable right now. Try reloading the page.';
        status.hidden = false;
      }
      return pagefind;
    };

    const open = (from?: HTMLElement | null) => {
      if (dialog.open) return;
      opener = from ?? (document.activeElement as HTMLElement | null);
      dialog.showModal();
      input.focus();
      input.select();
      void load();
    };
    const close = () => {
      dialog.close();
    };
    dialog.addEventListener('close', () => opener?.focus?.());

    const items = () => Array.from(list.querySelectorAll<HTMLAnchorElement>('.search-result'));
    const select = (i: number) => {
      const all = items();
      if (!all.length) return;
      selected = (i + all.length) % all.length;
      all.forEach((a, j) => a.setAttribute('aria-selected', String(j === selected)));
      all[selected].scrollIntoView({ block: 'nearest' });
      input.setAttribute('aria-activedescendant', all[selected].id);
    };

    const render = (rows: { url: string; title: string; section?: string; excerpt: string; sub?: string }[]) => {
      list.replaceChildren();
      selected = -1;
      rows.forEach((r, i) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'search-result';
        a.href = r.url;
        a.id = `search-opt-${i}`;
        a.setAttribute('role', 'option');
        a.setAttribute('aria-selected', 'false');
        const head = document.createElement('div');
        head.className = 'flex items-baseline gap-2';
        const t = document.createElement('span');
        t.className = 'text-sm font-medium text-fg';
        t.textContent = r.sub ? `${r.title} › ${r.sub}` : r.title;
        head.append(t);
        if (r.section) {
          const s = document.createElement('span');
          s.className = 'ml-auto shrink-0 text-[0.7rem] uppercase tracking-wider text-fg-subtle';
          s.textContent = r.section;
          head.append(s);
        }
        const ex = document.createElement('p');
        ex.className = 'mt-1 line-clamp-2 text-[0.8rem] leading-relaxed text-fg-muted';
        // Pagefind excerpts contain only <mark> tags around escaped text; rebuild them safely.
        const parts = r.excerpt.split(/(<mark>|<\/mark>)/);
        let marked = false;
        for (const p of parts) {
          if (p === '<mark>') marked = true;
          else if (p === '</mark>') marked = false;
          else if (p) {
            const txt = document.createTextNode(p.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, '&'));
            if (marked) {
              const m = document.createElement('mark');
              m.append(txt);
              ex.append(m);
            } else ex.append(txt);
          }
        }
        a.append(head, ex);
        a.addEventListener('mousemove', () => select(i));
        li.append(a);
        list.append(li);
      });
      input.setAttribute('aria-expanded', String(rows.length > 0));
      if (rows.length) select(0);
    };

    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(async () => {
        const q = input.value.trim();
        lastQuery = q;
        if (!q) {
          list.replaceChildren();
          status.hidden = false;
          status.textContent = 'Type to search all documentation.';
          return;
        }
        const pf = await load();
        if (!pf) return;
        const res = await pf.search(q);
        if (q !== lastQuery) return;
        const data = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
        if (q !== lastQuery) return;
        const rows: { url: string; title: string; section?: string; excerpt: string; sub?: string }[] = [];
        for (const d of data) {
          const title = d.meta.title ?? d.url;
          const subs = (d.sub_results ?? []).filter((s) => s.url !== d.url).slice(0, 2);
          rows.push({ url: d.url, title, section: d.meta.section, excerpt: d.excerpt });
          for (const s of subs) rows.push({ url: s.url, title, sub: s.title, section: d.meta.section, excerpt: s.excerpt });
        }
        status.hidden = rows.length > 0;
        status.textContent = rows.length ? '' : `No results for “${q}”.`;
        render(rows.slice(0, 14));
      }, 120);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        select(selected + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        select(selected - 1);
      } else if (e.key === 'Enter') {
        const a = items()[selected];
        if (a) {
          e.preventDefault();
          window.location.href = a.href;
          close();
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        close();
      }
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) close();
        else open();
      } else if (e.key === '/' && !dialog.open && !(e.target as HTMLElement).closest('input, textarea, [contenteditable]')) {
        e.preventDefault();
        open();
      }
    });
    document.querySelectorAll<HTMLElement>('[data-search-open]').forEach((b) => b.addEventListener('click', () => open(b)));
    dialog.querySelector('[data-search-close]')?.addEventListener('click', close);
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
  }
</script>
