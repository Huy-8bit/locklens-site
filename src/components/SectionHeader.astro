---
interface Props { eyebrow: string; title: string; lead?: string; center?: boolean; id?: string }
const { eyebrow, title, lead, center = false, id } = Astro.props;
---
<div class:list={['max-w-3xl', center && 'mx-auto text-center']} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="section-heading mt-3 text-[clamp(1.8rem,3.4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.025em] text-fg">{title}</h2>
  {lead && <p class="mt-4 text-[1.05rem] leading-relaxed text-fg-muted">{lead}</p>}
  <slot />
</div>
