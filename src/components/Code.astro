---
import { codeToHtml } from 'shiki';
interface Props { code: string; lang?: string; title?: string }
const { code, lang = 'sh', title } = Astro.props;
const html = await codeToHtml(code.trim(), { lang, theme: 'github-light' });
---
<div class="code-card relative overflow-hidden rounded-xl border border-line bg-[#f7faf6]">
  <div class="flex items-center gap-2 border-b border-line px-4 py-2">
    <span class="font-mono text-[0.7rem] uppercase tracking-wider text-fg-subtle">{title ?? lang}</span>
    <button type="button" class="copy-btn !static ml-auto" data-copy-code aria-label="Copy code to clipboard">Copy</button>
  </div>
  <div class="code-body overflow-x-auto px-4 py-3 font-mono text-[0.8rem] leading-relaxed [&_pre]:!bg-transparent" set:html={html} />
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', async () => {
      const pre = btn.closest('.code-card')?.querySelector('pre');
      if (!pre) return;
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        btn.textContent = 'Copied';
        btn.dataset.copied = 'true';
      } catch {
        btn.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => { btn.textContent = 'Copy'; delete btn.dataset.copied; }, 1600);
    });
  });
</script>
